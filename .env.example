# ==========================================
# Django Configuration
# ==========================================
DEBUG=True
SECRET_KEY=django-insecure-dev-only-change-in-production

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==========================================
# Database Configuration
# ==========================================
# Opción 1: URL completa
# DATABASE_URL=postgresql://user:password@localhost:5432/sis_banda

# Opción 2: Variables individuales (para Docker)
DB_NAME=sis_banda
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_HOST=localhost
DB_PORT=5432

# ==========================================
# CORS Configuration
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# ==========================================
# JWT Configuration (en segundos)
# ==========================================
ACCESS_TOKEN_LIFETIME=1800
REFRESH_TOKEN_LIFETIME=2592000

# ==========================================
# API Configuration
# ==========================================
API_HOST=localhost
API_PORT=8000
